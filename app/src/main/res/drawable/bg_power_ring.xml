<?xml version="1.0" encoding="utf-8"?>
<!-- Glowing concentric rings behind MYRA's face button -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="105dp"
                android:startColor="#40007BFF"
                android:endColor="#00007BFF" />
        </shape>
    </item>
    <item
        android:left="20dp"
        android:top="20dp"
        android:right="20dp"
        android:bottom="20dp">
        <shape android:shape="oval">
            <solid android:color="#12003B6B" />
            <stroke
                android:width="3dp"
                android:color="#4FC3F7" />
        </shape>
    </item>
    <item
        android:left="38dp"
        android:top="38dp"
        android:right="38dp"
        android:bottom="38dp">
        <shape android:shape="oval">
            <solid android:color="#0A0A28" />
        </shape>
    </item>
</layer-list>
