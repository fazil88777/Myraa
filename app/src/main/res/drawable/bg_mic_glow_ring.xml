<?xml version="1.0" encoding="utf-8"?>
<!-- Rotating blue/purple glow ring around the mic button (sweep gradient). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="ring"
    android:innerRadiusRatio="2.4"
    android:thicknessRatio="16"
    android:useLevel="false">
    <gradient
        android:type="sweep"
        android:startColor="#35C4FF"
        android:centerColor="#9B5CF6"
        android:endColor="#35C4FF" />
</shape>
