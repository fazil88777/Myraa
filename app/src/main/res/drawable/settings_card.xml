<?xml version="1.0" encoding="utf-8"?>
<!-- Settings card (video re-skin): very dark blue fill, subtle blue-grey
     stroke, ~14dp rounded corners. Used by every Settings row/button. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="14dp" />
    <solid android:color="#0C141E" />
    <stroke
        android:width="1dp"
        android:color="#283C50" />
</shape>
