<?xml version="1.0" encoding="utf-8"?>
<!-- Shell: full-screen tab container + ONE activity-level neon border
     framing every screen (the old LIA header bar and the old
     Home/Chat/AI/Tools/Profile bottom nav were removed — the dashboard
     home is the hub and has its own dot-nav). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#060A12">

    <!-- Tab content -->
    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Rainbow neon border (topmost, never blocks touches) -->
    <com.myra.assistant.ui.NeonBorderView
        android:id="@+id/neonBorderMain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false" />

</FrameLayout>
