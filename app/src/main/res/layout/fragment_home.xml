<?xml version="1.0" encoding="utf-8"?>
<!-- MYRA home (minimal theme: designs 11/12/13/14): full-screen girl art with
     slow breathing animation, drifting smoke overlay, ONE electric circle at
     knee height with OFF/LISTEN beneath it. Nothing else on screen —
     long-press the circle for Chat / Tools / Profile.
     Design 14 is special: its background is Fazil's animated looping video
     (home_bg_14) on the TextureView; the still art stays on top as the
     poster/fallback until the first video frame renders, and the native
     breathing + smoke stay OFF for that theme (the clip moves on its own). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF05070D">

    <!-- Looping background video (design 14 only; hidden for other themes) -->
    <TextureView
        android:id="@+id/bgVideo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Full-screen girl art ("breathing" scale applied in code).
         For design 14 this is the poster/fallback still for the video. -->
    <ImageView
        android:id="@+id/girlArtFull"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="MYRA"
        android:scaleType="centerCrop" />

    <!-- Slow drifting smoke overlay (procedural, tinted per theme) -->
    <com.myra.assistant.ui.SmokeDriftView
        android:id="@+id/smokeView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Electric circle at knee height (~78% down) + OFF/LISTEN -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="90dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <com.myra.assistant.ui.ElectricCircleView
            android:id="@+id/electricCircle"
            android:layout_width="170dp"
            android:layout_height="170dp"
            android:contentDescription="Voice" />

        <TextView
            android:id="@+id/micStateText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:letterSpacing="0.25"
            android:text="OFF"
            android:textColor="#8A97A5"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>

</FrameLayout>
