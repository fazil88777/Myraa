<?xml version="1.0" encoding="utf-8"?>
<!-- MYRA home (reference-style): clean dark background, big blue girl art,
     large glowing mic orb with concentric rings, OFF/LISTEN state,
     animated recording bars on the sides. No video bg, no input bar. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingBottom="70dp">

        <!-- Blue girl art -->
        <ImageView
            android:id="@+id/girlArt"
            android:layout_width="250dp"
            android:layout_height="330dp"
            android:adjustViewBounds="true"
            android:contentDescription="MYRA"
            android:scaleType="fitCenter"
            android:src="@drawable/myra_girl_home" />

        <!-- Mic row: bars | glowing mic | bars -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical|center_horizontal"
            android:orientation="horizontal">

            <com.myra.assistant.ui.WaveformView
                android:id="@+id/barsLeft"
                android:layout_width="56dp"
                android:layout_height="72dp"
                android:layout_marginRight="6dp" />

            <FrameLayout
                android:layout_width="190dp"
                android:layout_height="190dp">

                <!-- Soft outer halo -->
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:src="@drawable/bg_mic_halo" />

                <!-- Thin static concentric ring -->
                <ImageView
                    android:layout_width="170dp"
                    android:layout_height="170dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/bg_mic_ring_thin" />

                <!-- Rotating blue/purple sweep ring (visible while listening) -->
                <ImageView
                    android:id="@+id/micGlowRing"
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/bg_mic_glow_ring"
                    android:visibility="invisible" />

                <!-- The glowing mic orb button -->
                <LinearLayout
                    android:id="@+id/micButton"
                    android:layout_width="104dp"
                    android:layout_height="104dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_mic_orb"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_mic_white" />

                </LinearLayout>

            </FrameLayout>

            <com.myra.assistant.ui.WaveformView
                android:id="@+id/barsRight"
                android:layout_width="56dp"
                android:layout_height="72dp"
                android:layout_marginLeft="6dp" />

        </LinearLayout>

        <!-- Mic state -->
        <TextView
            android:id="@+id/micStateText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:letterSpacing="0.2"
            android:text="OFF"
            android:textColor="#6A7B8A"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Tap to speak"
            android:textColor="#4A5A6A"
            android:textSize="12sp" />

    </LinearLayout>

</FrameLayout>
