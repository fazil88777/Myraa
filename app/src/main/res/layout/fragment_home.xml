<?xml version="1.0" encoding="utf-8"?>
<!-- MYRA home (reference-style): clean dark background, big blue girl art,
     large glowing mic orb with concentric rings, OFF/LISTEN state,
     animated recording bars on the sides. No video bg, no input bar. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingBottom="70dp">

        <!-- Blue girl art -->
        <ImageView
            android:id="@+id/girlArt"
            android:layout_width="250dp"
            android:layout_height="330dp"
            android:adjustViewBounds="true"
            android:contentDescription="MYRA"
            android:scaleType="fitCenter"
            android:src="@drawable/myra_girl_home" />

        <!-- Mic row: bars | glowing mic | bars -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical|center_horizontal"
            android:orientation="horizontal">

            <com.myra.assistant.ui.WaveformView
                android:id="@+id/barsLeft"
                android:layout_width="56dp"
                android:layout_height="72dp"
                android:layout_marginRight="6dp" />

            <!-- Small rotating electric circle (tap to toggle voice session) -->
            <com.myra.assistant.ui.ElectricCircleView
                android:id="@+id/electricCircle"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:contentDescription="Voice" />

            <com.myra.assistant.ui.WaveformView
                android:id="@+id/barsRight"
                android:layout_width="56dp"
                android:layout_height="72dp"
                android:layout_marginLeft="6dp" />

        </LinearLayout>

        <!-- Mic state -->
        <TextView
            android:id="@+id/micStateText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:letterSpacing="0.2"
            android:text="OFF"
            android:textColor="#6A7B8A"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Tap to speak"
            android:textColor="#4A5A6A"
            android:textSize="12sp" />

    </LinearLayout>

</FrameLayout>
