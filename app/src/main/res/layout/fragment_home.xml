<?xml version="1.0" encoding="utf-8"?>
<!-- MYRA home (minimal theme: designs 11/12/13/14): full-screen girl art with
     slow breathing animation, drifting smoke overlay, ONE electric circle at
     knee height with OFF/LISTEN beneath it. Nothing else on screen —
     long-press the circle for Chat / Tools / Profile. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF05070D">

    <!-- Full-screen girl art ("breathing" scale applied in code) -->
    <ImageView
        android:id="@+id/girlArtFull"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="MYRA"
        android:scaleType="centerCrop" />

    <!-- Slow drifting smoke overlay (procedural, tinted per theme) -->
    <com.myra.assistant.ui.SmokeDriftView
        android:id="@+id/smokeView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Electric circle at knee height (~78% down) + OFF/LISTEN -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="90dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <com.myra.assistant.ui.ElectricCircleView
            android:id="@+id/electricCircle"
            android:layout_width="170dp"
            android:layout_height="170dp"
            android:contentDescription="Voice" />

        <TextView
            android:id="@+id/micStateText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:letterSpacing="0.25"
            android:text="OFF"
            android:textColor="#8A97A5"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>

</FrameLayout>
